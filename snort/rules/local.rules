# ==========================================
# Reglas Locales Educativas para Snort
# ==========================================

# 1. Detectar pings (ICMP) dirigidos a nuestra red
alert icmp any any -> $HOME_NET any (msg:"[EDUCATIVO] PING Detectado - Escaneo de Host"; sid:1000001; rev:1;)

# 2. Detectar intentos de acceso al archivo .env (sensible)
# Monitoreamos el puerto 3000 (tráfico interno descifrado de Nginx a API) y puertos 80/443
alert tcp any any -> $HOME_NET any (msg:"[EDUCATIVO] Intento de Acceso a archivo .env - Posible Robo de Credenciales"; content:".env"; nocase; sid:1000002; rev:1;)

# 3. Detectar inyección SQL en la URL o cuerpo (UNION SELECT)
alert tcp any any -> $HOME_NET any (msg:"[EDUCATIVO] Posible Inyeccion SQL Detectada (UNION SELECT)"; content:"union select"; nocase; sid:1000003; rev:1;)

# 4. Detectar intentos de Cross-Site Scripting (XSS) mediante etiquetas <script>
alert tcp any any -> $HOME_NET any (msg:"[EDUCATIVO] Posible inyeccion XSS Detectada (<script>)"; content:"<script>"; nocase; sid:1000004; rev:1;)
